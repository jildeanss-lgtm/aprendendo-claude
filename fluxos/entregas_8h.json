    {
      "parameters": {
        "jsCode": "// Libera as entregas que ficaram pendentes fora do horário: coloca o motoboy do turno da abertura.\nfunction normalizar(s) {\n  return String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\n}\nfunction minutos(hhmm) {\n  const m = /(\\d{1,2}):(\\d{2})/.exec(String(hhmm ?? ''));\n  return m ? Number(m[1]) * 60 + Number(m[2]) : NaN;\n}\n\nconst config = {};\nfor (const item of $('Ler configuracao').all()) config[item.json.parametro] = item.json.valor;\nconst abre = minutos(config.horario_abertura);\nconst fecha = minutos(config.horario_fechamento);\nconst agora = $now.setZone('America/Sao_Paulo');\nconst agoraMin = agora.hour * 60 + agora.minute;\n\n// Segurança: só libera dentro do horário de funcionamento.\nif (!(Number.isFinite(abre) && Number.isFinite(fecha) && agoraMin >= abre && agoraMin < fecha)) {\n  return [];\n}\n\nconst motoboys = $('Ler atendentes').all().map(i => i.json)\n  .filter(a => normalizar(a.funcao) === 'motoboy' && normalizar(a.ativo) === 'sim');\nconst doTurno = motoboys.find(a => {\n  const [ini, fim] = String(a.horario ?? '').split(/a|às|-|até/i).map(minutos);\n  return Number.isFinite(ini) && Number.isFinite(fim) && agoraMin >= ini && agoraMin < fim;\n});\nconst motoboy = (doTurno || motoboys[0] || {}).nome || '';\nif (!motoboy) return [];\n\nconst hoje = agora.toFormat('dd/MM HH:mm');\nconst pendentes = $('Ler entregas').all().map(i => i.json)\n  .filter(e => e && e.id_entrega && normalizar(e.status) === 'pendente' && String(e.motoboy ?? '').trim() === '');\n\nreturn pendentes.map(e => ({\n  json: {\n    id_entrega: e.id_entrega,\n    motoboy,\n    observacoes: [String(e.observacoes ?? '').trim(), `Liberada em ${hoje} para ${motoboy}.`].filter(Boolean).join(' '),\n  }\n}));\n"
      },
