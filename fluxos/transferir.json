    {
      "parameters": {
        "jsCode": "// Monta o registro da transferência (aba Atendimentos) e, se houver receita, o da aba Receitas.\nconst entrada = $('Entrada').first().json;\n\nfunction normalizar(s) {\n  return String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\n}\nfunction minutos(hhmm) {\n  const m = /(\\d{1,2}):(\\d{2})/.exec(String(hhmm ?? ''));\n  return m ? Number(m[1]) * 60 + Number(m[2]) : NaN;\n}\nfunction proximo(itens, campo, prefixo) {\n  let maior = 0;\n  const re = new RegExp('^' + prefixo + '(\\\\d+)$');\n  for (const i of itens) {\n    const m = re.exec(String(i.json?.[campo] ?? '').trim());\n    if (m) maior = Math.max(maior, Number(m[1]));\n  }\n  return prefixo + String(maior + 1).padStart(4, '0');\n}\n\nconst destino = normalizar(entrada.destino).startsWith('farmac') ? 'Farmacêutico' : 'Atendente';\nconst agora = $now.setZone('America/Sao_Paulo');\nconst agoraMin = agora.hour * 60 + agora.minute;\nconst dataHora = agora.toFormat('dd/MM/yyyy HH:mm:ss');\n\n// Pessoa do turno com a função de destino (aba Atendentes)\nconst pessoas = $('Ler atendentes').all().map(i => i.json)\n  .filter(a => normalizar(a.funcao) === normalizar(destino) && normalizar(a.ativo) === 'sim');\nconst doTurno = pessoas.find(a => {\n  const [ini, fim] = String(a.horario ?? '').split(/a|às|-|até/i).map(minutos);\n  return Number.isFinite(ini) && Number.isFinite(fim) && agoraMin >= ini && agoraMin < fim;\n});\nconst responsavel = (doTurno || pessoas[0] || {}).nome || '';\n\nconst atendimento = {\n  id_atendimento: proximo($('Ler atendimentos').all(), 'id_atendimento', 'ATD-'),\n  data_hora: dataHora,\n  telefone_cliente: \"'\" + entrada.telefone,\n  assunto: String(entrada.assunto ?? '').trim() || (destino === 'Farmacêutico' ? 'Saúde' : 'Atendimento'),\n  resumo: String(entrada.resumo ?? '').trim(),\n  transferido_para: destino,\n  status: 'Transferido',\n  id_pedido: '',\n};\n\n// Receita: só para o farmacêutico e com um tipo reconhecido\nconst t = normalizar(entrada.tipo_receita);\nlet tipo = '';\nif (t.startsWith('control')) tipo = 'Controlada';\nelse if (t.startsWith('antimicro') || t.startsWith('antibio')) tipo = 'Antimicrobiano';\nelse if (t.startsWith('comum') || t.startsWith('simples') || t.startsWith('normal')) tipo = 'Comum';\n\nlet receita = null;\nif (destino === 'Farmacêutico' && tipo) {\n  receita = {\n    id_receita: proximo($('Ler receitas').all(), 'id_receita', 'R'),\n    data_hora: dataHora,\n    telefone_cliente: \"'\" + entrada.telefone,\n    id_pedido: '',\n    link_foto: String(entrada.link_foto ?? '').trim() || '(foto enviada na conversa)',\n    tipo,\n    status: 'Aguardando validação',\n    farmaceutico: responsavel,\n    observacoes: atendimento.resumo,\n  };\n}\n\nconst quem = destino === 'Farmacêutico' ? 'o farmacêutico' : 'um atendente';\nconst mensagem = `TRANSFERIDO para ${destino}${responsavel ? ` (${responsavel})` : ''}: ${atendimento.id_atendimento}` +\n  (receita ? `, receita ${receita.id_receita} aguardando validação` : '') + '. ' +\n  `Avise o cliente com gentileza que ${quem} vai continuar o atendimento por aqui em breve. ` +\n  (receita ? 'Não registre o pedido: ele só é registrado depois que o farmacêutico aprovar a receita. ' : '') +\n  'Não chame esta ferramenta de novo para o mesmo assunto.';\n\nreturn [{ json: { mensagem, tem_receita: receita !== null, atendimento, receita } }];\n"
      },
